              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mecanico@oficina.local\",\n  \"senha\": \"Mecanico@2024\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "if (pm.response.body && pm.response.body.data && pm.response.body.data.accessToken) {",
                  "  pm.environment.set(\"token\", pm.response.body.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
