                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "if (pm.response.code === 200 && pm.response.body && pm.response.body.data) {",
                  "  pm.environment.set(\"ordemExecucaoId\", pm.response.body.data.id);",
                  "  const servico = (pm.response.body.data.itens || []).find((i) => i.tipo === \"SERVICO\");",
                  "  if (servico) {",
                  "    pm.environment.set(\"itemId\", servico.id);",
                  "  }",
                  "}"
                ]
              }
            }
